# ============================================================
# BRAVO MÉXICO — Variables de Entorno
# Copia este archivo como .env.local y rellena los valores
# NUNCA subas .env.local al repositorio
# ============================================================

# ── Base de Datos (Neon PostgreSQL) ──────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require

# ── Intelix CRM API ──────────────────────────────────────────
# URL base de la API de Intelix (confirmar con proveedor)
INTELIX_BASE_URL=https://api.intelix.mx
# Clave de autenticación de Intelix
INTELIX_API_KEY=

# ── Meta Conversions API (CAPI) ───────────────────────────────
# ID del Pixel de Meta (Facebook)
META_PIXEL_ID=
# Access Token del Pixel (System User Token o Marketing API)
META_ACCESS_TOKEN=
# Código de evento de prueba (solo para debugging en Meta Events Manager)
META_TEST_EVENT_CODE=

# ── Google Ads ────────────────────────────────────────────────
# Clave para Google Offline Conversion Import
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DEVELOPER_TOKEN=

# ── Analytics / Tracking ─────────────────────────────────────
# Google Tag Manager Container ID
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Seguridad Admin ───────────────────────────────────────────
# Clave secreta para proteger endpoints sensibles del panel admin
ADMIN_SECRET_KEY=CAMBIA_ESTA_CLAVE_EN_PRODUCCION
